{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pwt.local/schema/report-1.0.json",
  "title": "PWT scan report",
  "description": "Machine-readable PWT scan report envelope, schema version 1.0. Generated from sanitized persisted data only.",
  "type": "object",
  "required": ["schema_version", "run", "repository", "targets", "scanner_runs", "findings", "coverage", "scope_note"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "run": {
      "type": "object",
      "required": ["id", "repository_id", "state", "verdict", "source", "app_version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "repository_id": {"type": "string", "minLength": 1},
        "state": {"type": "string", "enum": ["CREATED", "RUNNING", "COMPLETED", "PARTIAL", "FAILED", "CANCELLED", "INTERRUPTED"]},
        "verdict": {"type": "string", "enum": ["FINDINGS", "NO_FINDINGS", "INDETERMINATE"]},
        "created_at": {"type": ["string", "null"]},
        "started_at": {"type": ["string", "null"]},
        "finished_at": {"type": ["string", "null"]},
        "source": {"type": "string", "enum": ["GUI", "CLI"]},
        "app_version": {"type": "string", "minLength": 1},
        "error_code": {"type": ["string", "null"]},
        "error_message": {"type": ["string", "null"]}
      }
    },
    "repository": {
      "type": "object",
      "required": ["display_name"],
      "properties": {
        "display_name": {"type": "string", "minLength": 1}
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["relative_path", "content_sha256", "size_bytes"],
        "properties": {
          "relative_path": {"type": "string", "minLength": 1},
          "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "scanner_runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["adapter_id", "tool_name", "status"],
        "properties": {
          "adapter_id": {"type": "string", "minLength": 1},
          "tool_name": {"type": "string", "minLength": 1},
          "tool_version": {"type": ["string", "null"]},
          "status": {"type": "string", "enum": ["PENDING", "RUNNING", "SUCCEEDED", "FAILED", "SKIPPED", "NOT_APPLICABLE", "UNAVAILABLE", "TIMED_OUT", "CANCELLED", "INTERRUPTED"]},
          "exit_code": {"type": ["integer", "null"]},
          "message": {"type": ["string", "null"]}
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "title", "severity", "category", "message", "fingerprint"],
        "properties": {
          "rule_id": {"type": "string", "minLength": 1},
          "title": {"type": "string"},
          "severity": {"type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO", "UNKNOWN"]},
          "original_severity": {"type": ["string", "null"]},
          "category": {"type": "string", "minLength": 1},
          "relative_path": {"type": ["string", "null"]},
          "line_start": {"type": ["integer", "null"], "minimum": 1},
          "line_end": {"type": ["integer", "null"], "minimum": 1},
          "column_start": {"type": ["integer", "null"], "minimum": 1},
          "message": {"type": "string"},
          "evidence": {"type": "object"},
          "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "coverage": {
      "type": "object",
      "required": ["complete", "gaps"],
      "properties": {
        "complete": {"type": "boolean"},
        "gaps": {"type": "array", "items": {"type": "string"}}
      }
    },
    "scope_note": {"type": "string", "minLength": 1}
  }
}
