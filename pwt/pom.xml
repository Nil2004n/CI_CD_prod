<?xml version="1.0" encoding="UTF-8"?>
<!--
  PWT Phase 1 — single Maven project.
  Pinned stack (verified 2026-11-12 against Maven Central + javap):
  - JDK 21 (build + target)
  - Apache Maven 3.9.11 (via Maven Wrapper 3.3.2)
  - OpenJFX 21.0.8 (linux classifier jars; LTS line compatible with JDK 21)
  - Java MCP SDK io.modelcontextprotocol.sdk:mcp 0.8.1
    (API verified by bytecode inspection: McpServer.sync,
    SyncSpecification, StdioServerTransportProvider,
    McpSchema Tool/JsonSchema/CallToolResult/TextContent records)
  - Jackson Databind 2.17.0 (matches MCP SDK 0.8.1's own dependency)
  - slf4j-api 2.0.16 (matches MCP SDK 0.8.1) + slf4j-simple 2.0.16
    (SimpleLogger defaults to stderr; stdout stays MCP-protocol-only)
  - JUnit Jupiter 5.13.4
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.pwt</groupId>
  <artifactId>pwt</artifactId>
  <version>1.1.0</version>
  <packaging>jar</packaging>
  <name>PWT (Phase 1 rebuild)</name>
  <description>Local-first YAML assessment workbench: JavaFX desktop shell, safe YAML discovery, MCP stdio spike.</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>
    <javafx.version>21.0.8</javafx.version>
    <mcp.version>0.8.1</mcp.version>
    <jackson.version>2.17.0</jackson.version>
    <sqlite.version>3.49.1.0</sqlite.version>
    <snakeyaml.version>2.7</snakeyaml.version>
    <jsonschema.version>1.5.9</jsonschema.version>
    <slf4j.version>2.0.16</slf4j.version>
    <junit.version>5.13.4</junit.version>
    <main.class>pwt.launcher.PwtMain</main.class>
  </properties>

  <dependencies>
    <!-- JavaFX (desktop shell only; domain/application never touch it) -->
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
      <classifier>linux</classifier>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-graphics</artifactId>
      <version>${javafx.version}</version>
      <classifier>linux</classifier>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-base</artifactId>
      <version>${javafx.version}</version>
      <classifier>linux</classifier>
    </dependency>

    <!-- Java MCP SDK (stdio server spike) -->
    <dependency>
      <groupId>io.modelcontextprotocol.sdk</groupId>
      <artifactId>mcp</artifactId>
      <version>${mcp.version}</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>

    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>${sqlite.version}</version>
    </dependency>

    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
      <version>${snakeyaml.version}</version>
    </dependency>
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      <version>${jsonschema.version}</version>
    </dependency>

    <!-- Logging: SimpleLogger writes to stderr, never stdout -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>${slf4j.version}</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${slf4j.version}</version>
    </dependency>

    <!-- Tests -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.3</version>
        <configuration>
          <!-- Keep test logging on stderr; never let it near tested stdout streams. -->
          <systemPropertyVariables>
            <org.slf4j.simpleLogger.logFile>System.err</org.slf4j.simpleLogger.logFile>
            <org.slf4j.simpleLogger.defaultLogLevel>warn</org.slf4j.simpleLogger.defaultLogLevel>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>${main.class}</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
